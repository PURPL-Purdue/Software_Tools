# MongoDB Atlas or another deployment, transactions are used for stock writes
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=purpl_inventory

# Comma-separated development/production frontends
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 25 mib default
MAX_ATTACHMENT_BYTES=26214400